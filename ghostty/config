# Ghostty Configuration (Migrated from Kitty)

# Font
font-family = "JetBrainsMono Nerd Font"
font-size = 12

# Window
background-opacity = 1
window-padding-x = 10
window-padding-y = 10

# Cursor
cursor-style-blink = false

# Other
shell-integration = fish
confirm-close-surface = false
tab-inherit-working-directory = true
window-inherit-working-directory = false
working-directory = home
split-inherit-working-directory = false

# Theme (Managed by switch_theme.sh)
config-file = theme

# Tab Bar & Window Style (OLED Monochrome Minimal)
gtk-titlebar = false
gtk-titlebar-style = native
gtk-toolbar-style = flat
window-show-tab-bar = auto
gtk-tabs-location = top
gtk-wide-tabs = false
window-title-font-family = "JetBrainsMono Nerd Font"
window-new-tab-position = current
gtk-custom-css = /home/matteo/.config/ghostty/style.css

